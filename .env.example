# ==========================================================================
# 漫剧生成系统 · 环境配置模板
# --------------------------------------------------------------------------
# 用法：复制本文件为 .env 并填入实际值（.env 已被 .gitignore 忽略，不会提交）
#       cp .env.example .env
# ==========================================================================

# ===================== ComfyUI 引擎路径（必填） =====================
# ComfyUI 服务地址
COMFYUI_URL=http://127.0.0.1:8188

# ComfyUI 安装根目录（下面三项默认基于此拼接，也可单独覆盖）
# Windows 示例：D:/ComfyUI_portable_TE_v260619
# Linux/macOS 示例：/home/user/ComfyUI
COMFYUI_ROOT=D:/ComfyUI_portable_TE_v260619

# 以下三项留空则按 COMFYUI_ROOT 自动推导，通常无需修改
COMFYUI_WORKFLOWS_DIR=
COMFYUI_INPUT_DIR=
COMFYUI_OUTPUT_DIR=

# ===================== 模型路径（选填） =====================
# 留空则按 COMFYUI_ROOT 推导；模型权重不入库，需自行下载放置
MODELS_DIR=

# ===================== 显示与显存档案（选填） =====================
# 8G / 16G / server —— 影响超分与视频生成的默认档位
DEPLOY_PROFILE=16G

# ===================== AI 模型密钥（推荐方式） =====================
# 文本分析模型（小说转剧本 / 提示词分析 / AI 对话总控 —— 2026-10-12 text 与 chat 已合并）
MJSCXT_BASE_URL_TEXT=https://integrate.api.nvidia.com/v1
MJSCXT_API_KEY_TEXT=
MJSCXT_MODEL_TEXT=

# 质检模型（需支持图像输入的多模态模型）
MJSCXT_BASE_URL_QC=
MJSCXT_API_KEY_QC=
MJSCXT_MODEL_QC=

# 对话总控模型已并入「文本分析模型」（2026-10-12 text+chat 合并，config.AI_MODULES 仅剩 text/qc）。
# 以下 *_CHAT 三变量仅供旧版 .env 向后兼容（secret_store.py 仍读取并归一为 ai.text），新配置只需填 TEXT。
MJSCXT_BASE_URL_CHAT=
MJSCXT_API_KEY_CHAT=
MJSCXT_MODEL_CHAT=

# ===================== 密钥加密主密钥（重要） =====================
# 用于加密 output/secrets.enc 中的密钥。
# 留空则自动生成 .secret_key 文件（本地开发够用）；
# 团队/服务器部署请显式设置，并妥善保管——更换后已有加密密钥将无法解密。
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MJSCXT_SECRET_KEY=

# ===================== 无人值守托管（选填） =====================
# 是否随服务启动自动恢复「已启用项目」的生产。默认开启（24/7 无人值守）。
# 仅在需要临时独占 GPU 时关闭，例如：跑验证脚本、数据迁移、手工单步生成。
# 关闭写法：MJSCXT_AUTOPILOT=0
MJSCXT_AUTOPILOT=1

# ===================== 服务端口（选填） =====================
APP_HOST=127.0.0.1
APP_PORT=5000

# WSGI 服务器线程数与连接空闲超时（秒）
# 无人值守长时间生产建议保留默认值：单集生成可能持续数十分钟，
# 超时给小了会在生成中途被中间层掐断连接。
APP_THREADS=8
APP_CHANNEL_TIMEOUT=1800


# ===================== 引擎 Provider 选择（P1-4 本地/云端双通道） =====================
# 可选值见 /api/providers 接口（items 列表）。
# image：comfyui-local | doubao-cloud
# video：comfyui-local | wan-cloud | kling-cloud | vidu-cloud | veo-cloud
# tts  ：qwen-tts-local | cosyvoice-cloud
# 留空 = 使用默认本地引擎；云端 Provider 需另行提供各自的鉴权环境变量。
MJSCXT_PROVIDER_IMAGE=comfyui-local
MJSCXT_PROVIDER_VIDEO=comfyui-local
MJSCXT_PROVIDER_TTS=qwen-tts-local

# ===================== 常用进阶配置（审计 P2-8 补录，均有默认值） =====================
# ⚠️ 以下默认全部**注释状态**（留空字符串可能让 int() 解析报错）；要启用就取消注释并填值。
# 完整可配置面以 app/config.py 的 os.getenv 为准。
# LLM 请求超时（秒，默认见 config.py）。长文写镜/重写耗时长，网络慢可调大
# LLM_REQUEST_TIMEOUT=600
# GPU 任务并发闸门：同时打 ComfyUI 的任务上限（单卡建议 1）
# TASK_QUEUE_CONCURRENCY=1
# 生成结束后是否保留已加载模型（1=保留，省去每次重读 19.5GB 权重；0=每次 /free 卸载）
# MJSCXT_KEEP_MODEL_LOADED=1
# H3 视频单段最长秒数（2026-10-11 用户决策「取消长镜切段」：4.0→12.0，等效不切段；调小回 ≤8 才重新切段）
# H3_SEGMENT_MAX_SEC=12.0
# 场景机位档开关（1=按镜头机位逐档独立出图；0=一键回滚只用正面档）
# SCENE_VIEWS_ENABLED=1
# 尾帧链式模式（auto/chain/off）：同场景下一镜首帧复用上一镜尾帧
# KEYFRAME_CHAIN_MODE=auto
# H3 Director 公共参考图（1=全集共用的资产走公共池；0=全部段级内联）
# H3_COMMON_REFS=0
# 超分引擎（te-speed-flashvsr | legacy-flashvsr；留空自动选择）
# UPSCALE_ENGINE=te-speed-flashvsr
# 分镜候选张数（best-of-N 选图，1-4；默认 1 零回归）
# STORYBOARD_CANDIDATES=1
# 数据目录重定向（便携/桌面版用；留空用项目内 output/）
# MJSCXT_DATA_DIR=
