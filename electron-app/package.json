{
  "name": "mjscxt-desktop",
  "version": "1.4.2",
  "description": "漫剧工坊桌面版：Electron 壳 + 本地 Flask 后端（serve.py）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack:backend": "node pack_backend.js",
    "build:win": "electron-builder --win",
    "build:win:local": "electron-builder --win --config.electronDist=C:/Users/liujianghua/mjscxt_desktop/electron"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.mjscxt.desktop",
    "productName": "漫剧工坊",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "update-config.js",
      "build/**"
    ],
    "extraResources": [
      {
        "from": "_backend/python",
        "to": "python"
      },
      {
        "from": "_backend/app",
        "to": "backend"
      },
      {
        "from": "_backend/workflows",
        "to": "workflows"
      },
      {
        "from": "_backend/locales",
        "to": "locales"
      },
      {
        "from": "_backend/.env",
        "to": ".env"
      },
      {
        "from": "_backend/main.py",
        "to": "main.py",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "comic-drama-forge-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "comic-drama-forge-Portable-${version}.${ext}"
    },
    "electronVersion": "33.4.11",
    "directories": {
      "output": "dist"
    },
    "asar": false
  },
  "author": "mjscxt"
}
